node_modules/
.DS_Store
*.log

# Amp portal registrations belong to each orb.
.amp/portals/*

# The local orchestration bridge contains a session credential.
.orchestrate/bridge.json

# Python bytecode inside skill dirs fails the pack validator as a binary file.
__pycache__/
*.pyc

# Claude Code writes a plugin's API types here when it loads the plugin;
# they are build-specific, so each contributor's engine regenerates them.
plugins/*/.claude-plugin/types/

# Private patterns for scripts/check-private-terms.mjs; never commit.
.private-terms
